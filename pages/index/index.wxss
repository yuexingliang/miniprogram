/* pages/index/index.wxss */
.hero {
  padding: 80rpx 0 30rpx;
  position: relative;
  z-index: 1;
}

/* 五行飘字 */
.wuxing-tags {
  display: flex;
  justify-content: space-around;
  margin: 20rpx 60rpx 0;
  position: relative;
  z-index: 1;
}
.wx-tag {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-shadow: 0 0 18rpx currentColor;
  animation: float 4s ease-in-out infinite;
}
.wx-tag.wx-jin  { color: var(--c-metal); animation-delay: 0s; }
.wx-tag.wx-mu   { color: var(--c-wood);  animation-delay: 0.4s; }
.wx-tag.wx-shui { color: var(--c-water); animation-delay: 0.8s; }
.wx-tag.wx-huo  { color: var(--c-fire);  animation-delay: 1.2s; }
.wx-tag.wx-tu   { color: var(--c-earth); animation-delay: 1.6s; }
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* 表单 */
.form .row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  gap: 20rpx;
}
.form .row.col {
  display: block;
}
.label {
  width: 180rpx;
  flex-shrink: 0;
  color: var(--c-gold-soft);
  letter-spacing: 4rpx;
  font-size: 28rpx;
}
.label .hint {
  font-size: 22rpx;
  color: rgba(245,215,110,0.55);
  letter-spacing: 0;
}
.input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: rgba(0,0,0,0.4);
  border: 1rpx solid rgba(212,175,55,0.35);
  color: var(--c-ink);
  font-size: 28rpx;
}
.ph {
  color: rgba(233,216,166,0.4);
  letter-spacing: 4rpx;
}
.picker-box {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: rgba(0,0,0,0.4);
  border: 1rpx solid rgba(212,175,55,0.35);
  color: var(--c-ink);
  font-size: 28rpx;
}
.seg {
  flex: 1;
  display: flex;
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(212,175,55,0.35);
}
.seg-item {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: rgba(233,216,166,0.7);
  background: rgba(0,0,0,0.3);
  letter-spacing: 4rpx;
}
.seg-item.active {
  background: linear-gradient(135deg, rgba(212,175,55,0.85), rgba(245,215,110,0.55));
  color: #1a0d2a;
  font-weight: bold;
  text-shadow: none;
}

/* 主题 */
.topics {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.topic {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(212,175,55,0.35);
  background: rgba(0,0,0,0.35);
  font-size: 26rpx;
  color: rgba(233,216,166,0.8);
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  transition: all 0.25s;
}
.topic-icon { font-size: 28rpx; }
.topic-on {
  background: linear-gradient(135deg, rgba(192,57,43,0.85), rgba(212,175,55,0.85));
  color: #1a0d2a;
  border-color: var(--c-gold);
  box-shadow: 0 0 24rpx rgba(212,175,55,0.5);
  font-weight: bold;
}

/* 起卦按钮 */
.btn-divine {
  margin: 50rpx 0 0;
  width: 100%;
  height: 110rpx;
  padding: 0;
  line-height: 1;          /* 用 flex 居中，line-height 不再承担对齐 */
  color: #1a0d2a;
  background: linear-gradient(135deg, #f5d76e, #d4af37 50%, #b8860b);
  border-radius: 14rpx;
  border: 2rpx solid #fff5cc;
  box-shadow:
    0 0 30rpx rgba(212,175,55,0.6),
    inset 0 0 20rpx rgba(255,255,255,0.3);
  position: relative;
  overflow: hidden;
}
/* 重置微信 button 自带的 ::after 1rpx 边框，避免叠加 */
.btn-divine::after {
  border: none;
}
/* shine 高光改到 ::before，腾出 ::after 给微信内置 */
.btn-divine::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.6) 50%, transparent 70%);
  animation: shine 2.6s linear infinite;
  pointer-events: none;
  z-index: 1;
}
.btn-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  position: relative;
  z-index: 2;
  white-space: nowrap;
  flex-wrap: nowrap;
}
.btn-text {
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 8rpx;
  /* letter-spacing 会在最后一个字右侧也补一格，用 text-indent 抵消，让视觉居中 */
  text-indent: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(255,255,255,0.4);
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1;
}
.btn-rune {
  font-size: 32rpx;
  color: rgba(26,13,42,0.55);
  font-weight: normal;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1;
}
@keyframes shine {
  to { left: 200%; }
}
.btn-hover {
  opacity: 0.88;
  transform: scale(0.99);
}
.tip {
  margin-top: 30rpx;
  font-size: 22rpx;
  text-align: center;
  color: rgba(233,216,166,0.5);
  letter-spacing: 4rpx;
}
